.idea/
.vscode/
*.iml
*.ipr
*.iws
# IDEA 运行配置（内含本地环境变量，不入库）
.run/

# ---------- Word 临时文件与锁文件 ----------
~$*
~WRL*.tmp
*.tmp

# ---------- 构建产物 ----------
target/
build/
out/
*.class
dist/

# ---------- 前端依赖与缓存 ----------
node_modules/
.vite/
*.local

# ---------- 日志 ----------
*.log

# ---------- Python ----------
__pycache__/
*.py[cod]
.venv/
venv/

# ---------- AI 模型权重（体积较大，按需本地放置） ----------
ai_service/models/*.pt
ai_service/models/*.pth
ai_service/models/*.onnx

# ---------- 运行时产生的图片 ----------
backend/uploads/
ai_service/outputs/
ai_service/outputs_local/

# ---------- 本地环境变量文件 ----------
.env
.env.*
*.env
# 本地开发配置含明文密码，不入库
backend/src/main/resources/application-dev.yaml
